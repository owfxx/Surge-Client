{
  "name": "surge-client",
  "productName": "Surge Client",
  "version": "1.6.0",
  "description": "Surge Client - optimized Minecraft launcher",
  "main": "src/main.js",
  "author": "owfx",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "dist:dir": "electron-builder --win dir"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5",
    "skinview3d": "^3.4.2"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "resedit": "^2.0.3"
  },
  "build": {
    "appId": "gg.surge.client",
    "productName": "Surge Client",
    "copyright": "Copyright © 2026 owfx",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Surge Client",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Surge-Client-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Surge-Client-${version}-Standalone.${ext}"
    },
    "afterPack": "build/afterPack.js"
  }
}
